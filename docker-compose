version: "3.9"

services:
  app:
    build:
      context: .
      dockerfile: Dockerfile
    container_name: rideconnect_app
    restart: unless-stopped
    working_dir: /var/www
    volumes:
      - .:/var/www:cached
    user: "1000:1000"
    command: /bin/sh /var/www/scripts/entrypoint.sh
    ports:
      - "8000:10000"
    dns:
      - 8.8.8.8
      - 8.8.4.4
    environment:
      APP_ENV: local
      APP_DEBUG: "true"
      DB_CONNECTION: pgsql
      DB_HOST: aws-1-us-east-1.pooler.supabase.com
      DB_PORT: 5432
      DB_DATABASE: postgres
      DB_USERNAME: postgres.tpahuvmhlfluztuhznfj
      DB_PASSWORD: ${DB_PASSWORD}
      DB_SSLMODE: require
      SUPABASE_URL: https://tpahuvmhlfluztuhznfj.supabase.co
      SUPABASE_KEY: ${SUPABASE_KEY}
      SUPABASE_SERVICE_ROLE_KEY: ${SUPABASE_SERVICE_ROLE_KEY}
    networks:
      - rideconnect

networks:
  rideconnect:
    driver: bridge