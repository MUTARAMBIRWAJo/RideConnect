# RideConnect ML Microservice Environment Configuration
# Copy this file to .env and update with your actual values

# Application
APP_NAME="RideConnect ML Service"
APP_VERSION="1.0.0"
DEBUG=false
LOG_LEVEL=INFO

# Server
ML_SERVICE_HOST=0.0.0.0
ML_SERVICE_PORT=8000

# Model
MODEL_PATH=/app/models/trained/rideconnect_v2_best.keras
MODEL_VERSION=2.0

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key
SUPABASE_DB_URL=postgresql://postgres:password@localhost:5432/rideconnect

# Redis
REDIS_URL=redis://redis:6379/0
ENABLE_CACHING=true
CACHE_TTL=3600

# Feature Normalization
DISTANCE_MAX_KM=50.0
ACCEPTANCE_RATE_MAX=100.0
CANCELLATION_RATE_MAX=100.0
BEHAVIOR_SCORE_MAX=100.0
