{
  "model_name": "driver_ranker",
  "algorithm": "XGBClassifier",
  "feature_columns": [
    "distance_to_pickup_km",
    "driver_rating",
    "acceptance_rate",
    "vehicle_type_encoded",
    "hour_of_day",
    "day_of_week"
  ],
  "vehicle_classes": [
    "minibus",
    "moto",
    "sedan",
    "suv"
  ],
  "hyperparameters": {
    "n_estimators": 100,
    "max_depth": 4,
    "learning_rate": 0.1,
    "random_state": 42
  },
  "training_metrics": {
    "f1": 0.5531914893617021,
    "precision": 0.7142857142857143,
    "recall": 0.4513888888888889,
    "roc_auc": 0.865185414549458,
    "precision_at_1": 0.6926829268292682
  },
  "training_targets": {
    "roc_auc_min": 0.78,
    "precision_at_1_min": 0.6,
    "rationale": "ROC-AUC measures discrimination; Precision@1 measures ranking. Random Precision@1 baseline = 0.20 (1-of-5). Target of 0.60 represents 3x random performance, appropriate for ride-matching with synthetic training data. Real-data fine-tuning expected to push Precision@1 toward 0.80+."
  },
  "label": "completed",
  "label_meaning": {
    "1": "trip completed successfully",
    "0": "cancelled or rejected"
  },
  "endpoint": "/ml/rank-drivers",
  "method": "POST"
}