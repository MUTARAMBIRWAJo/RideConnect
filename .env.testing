# App Environment
APP_NAME=RideConnect
APP_ENV=testing
APP_KEY=base64:KjlbW8W5Ed5UR4NES/iw/8aOHBcsUl9t6WQdRaKmI5M=
APP_DEBUG=true
APP_URL=http://localhost:8080

# Testing Database - isolated SQLite (never points at Supabase)
DB_CONNECTION=sqlite
TEST_DB_CONNECTION=sqlite
DB_DATABASE=:memory:
DB_FOREIGN_KEYS=true

# Migration safety tests can opt in via config flag
DB_TABLE_PROTECTION=false
DB_PROTECTION_ENABLE_DURING_TESTS=false

# Logging
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Cache & Session
CACHE_DRIVER=array
SESSION_DRIVER=array
SESSION_LIFETIME=120

# Queue
QUEUE_CONNECTION=sync

# AI Service (Prediction & ML)
RIDE_AI_BASE_URL=https://ml-service-j72g.onrender.com
RIDE_AI_TIMEOUT=10
ML_RANKING_ENABLED=false

# Mail
MAIL_MAILER=array

# Filesystem
FILESYSTEM_DRIVER=local
