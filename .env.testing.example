APP_NAME=RideConnect
APP_ENV=testing
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=warning

# Test DB should be a dedicated Postgres database/schema, not production.
DB_CONNECTION=pgsql
TEST_DB_CONNECTION=pgsql
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=5432
TEST_DB_DATABASE=rideconnect_test
TEST_DB_USERNAME=postgres
TEST_DB_PASSWORD=postgres
TEST_DB_SSLMODE=prefer
TEST_DB_SCHEMA=public

CACHE_STORE=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
MAIL_MAILER=array