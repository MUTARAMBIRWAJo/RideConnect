APP_NAME=RideConnect
APP_ENV=testing
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=warning

# Test DB should be a dedicated Postgres database/schema, not production.
DB_CONNECTION=sqlite
DB_DATABASE=:memory:
TEST_DB_CONNECTION=sqlite
TEST_DB_DATABASE=:memory:

CACHE_STORE=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
MAIL_MAILER=array