        {
            "name": "9. Verify Profile Updated (Get Profile Again)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "var jsonData = pm.response.json();",
                            "var data = jsonData.data;",
                            "var stats = data.statistics;",
                            "var prefs = data.preferences;",
                            "",
                            "console.log('\\n========================================');",
                            "console.log('FINAL PASSENGER PROFILE - AFTER UPDATES');",
                            "console.log('========================================\\n');",
                            "",
                            "console.log('👤 BASIC INFORMATION');",
                            "console.log('├─ ID: ' + data.id);",
                            "console.log('├─ Name: ' + data.name);",
                            "console.log('├─ Email: ' + data.email);",
                            "console.log('├─ Phone: ' + data.phone);",
                            "console.log('├─ Status: ' + (data.is_approved ? '✓ Approved' : '✗ Not Approved'));",
                            "console.log('└─ Member Since: ' + data.member_since);",
                            "",
                            "console.log('\\n📊 STATISTICS');",
                            "console.log('├─ Total Trips: ' + stats.total_trips);",
                            "console.log('├─ Total Bookings: ' + stats.total_bookings);",
                            "console.log('├─ Total Spent: ' + stats.total_spent);",
                            "console.log('├─ Rating: ⭐ ' + stats.rating + '/5');",
                            "console.log('├─ Reliability: ' + (stats.reliability_score * 100).toFixed(1) + '%');",
                            "console.log('└─ Cancellation Rate: ' + (stats.cancellation_rate * 100).toFixed(1) + '%');",
                            "",
                            "console.log('\\n🎯 PREFERENCES (UPDATED)');",
                            "console.log('├─ Payment Method: ' + prefs.preferred_payment_method);",
                            "console.log('├─ Emergency Contact: ' + prefs.emergency_contact_name);",
                            "console.log('├─ Emergency Phone: ' + prefs.emergency_contact_phone);",
                            "console.log('└─ Saved Locations: ' + prefs.saved_locations_count);",
                            "",
                            "console.log('\\n✅ VERIFICATION');",
                            "console.log('├─ Verified: ' + (data.verification.verified ? 'Yes' : 'No'));",
                            "console.log('└─ Approved: ' + (data.verification.approved ? 'Yes' : 'No'));",
                            "",
                            "console.log('\\n========================================\\n');"
                        ]
                    }
                }
            ],
