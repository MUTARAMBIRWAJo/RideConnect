        {
            "name": "6. Update Profile - Multiple Fields",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('All fields updated correctly', function () {",
                            "    var jsonData = pm.response.json();",
                            "    var data = jsonData.data;",
                            "    var prefs = data.preferences;",
                            "    ",
                            "    pm.expect(data.name).to.equal('Jean Mugabo');",
                            "    pm.expect(data.phone).to.equal('+250780126094');",
                            "    pm.expect(prefs.preferred_payment_method).to.equal('card');",
                            "    pm.expect(prefs.emergency_contact_name).to.equal('Marie Mugabo');",
                            "    pm.expect(prefs.emergency_contact_phone).to.equal('+250788654321');",
                            "});",
                            "",
                            "var jsonData = pm.response.json();",
                            "console.log('\\n✓ PROFILE UPDATED SUCCESSFULLY');",
                            "console.log('Updated Fields:');",
                            "console.log('- Name: ' + jsonData.data.name);",
                            "console.log('- Phone: ' + jsonData.data.phone);",
                            "console.log('- Payment: ' + jsonData.data.preferences.preferred_payment_method);",
                            "console.log('- Emergency Contact: ' + jsonData.data.preferences.emergency_contact_name);"
                        ]
