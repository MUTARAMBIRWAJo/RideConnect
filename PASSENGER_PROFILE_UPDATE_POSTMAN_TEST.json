{
    "info": {
        "name": "RideConnect - Passenger Profile Update Complete Tests",
        "description": "Complete test suite for PUT /v1/passenger/profile endpoint with Flutter mobile app integration examples",
        "version": "1.0.0"
    },
    "item": [
        {
            "name": "1. Login Passenger",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "if (pm.response.code === 200) {",
                            "    var jsonData = pm.response.json();",
                            "    pm.environment.set('passenger_token', jsonData.token);",
                            "    pm.environment.set('passenger_id', jsonData.user.id);",
                            "    console.log('✓ Token saved');",
                            "}"
                        ]
                    }
                }
            ],
            "request": {
                "method": "POST",
                "header": [
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"email_or_phone\": \"jean.mugabo@example.com\",\n  \"password\": \"Password123!\"\n}"
                },
                "url": {
                    "raw": "{{base_url}}/api/v1/auth/mobile/login",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "api",
                        "v1",
                        "auth",
                        "mobile",
                        "login"
                    ]
                }
            }
        },
        {
            "name": "2. Get Current Profile (Before Update)",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Status code is 200', function () {",
                            "    pm.response.to.have.status(200);",
                            "});",
                            "",
                            "pm.test('Response has success flag', function () {",
                            "    var jsonData = pm.response.json();",
                            "    pm.expect(jsonData.success).to.be.true;",
                            "});",
                            "",
                            "var jsonData = pm.response.json();",
                            "pm.environment.set('original_name', jsonData.data.name);",
                            "pm.environment.set('original_phone', jsonData.data.phone);",
                            "console.log('Current Profile:');",
                            "console.log('- Name: ' + jsonData.data.name);",
                            "console.log('- Phone: ' + jsonData.data.phone);",
                            "console.log('- Payment Method: ' + jsonData.data.preferences.preferred_payment_method);"
                        ]
                    }
                }
            ],
            "request": {
                "method": "GET",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{passenger_token}}"
                    }
                ],
                "url": {
                    "raw": "{{base_url}}/api/v1/passenger/profile",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "api",
                        "v1",
                        "passenger",
                        "profile"
                    ]
                }
            }
        },
        {
            "name": "3. Update Profile - Name Only",
            "event": [
                {
                    "listen": "test",
                    "script": {
                        "exec": [
                            "pm.test('Status code is 200', function () {",
                            "    pm.response.to.have.status(200);",
                            "});",
                            "",
                            "pm.test('Response has success flag', function () {",
                            "    var jsonData = pm.response.json();",
                            "    pm.expect(jsonData.success).to.be.true;",
                            "    pm.expect(jsonData.message).to.include('updated successfully');",
                            "});",
                            "",
                            "pm.test('Name field updated', function () {",
                            "    var jsonData = pm.response.json();",
                            "    pm.expect(jsonData.data.name).to.equal('Jean Mugabo Updated');",
                            "});",
                            "",
                            "pm.test('Profile returned with full data', function () {",
                            "    var jsonData = pm.response.json();",
                            "    var data = jsonData.data;",
                            "    pm.expect(data).to.have.property('statistics');",
                            "    pm.expect(data).to.have.property('preferences');",
                            "    pm.expect(data).to.have.property('verification');",
                            "});"
                        ]
                    }
                }
            ],
            "request": {
                "method": "PUT",
                "header": [
                    {
                        "key": "Authorization",
                        "value": "Bearer {{passenger_token}}"
                    },
                    {
                        "key": "Content-Type",
                        "value": "application/json"
                    }
                ],
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"name\": \"Jean Mugabo Updated\"\n}"
                },
                "url": {
                    "raw": "{{base_url}}/api/v1/passenger/profile",
                    "host": [
                        "{{base_url}}"
                    ],
                    "path": [
                        "api",
                        "v1",
                        "passenger",
                        "profile"
                    ]
                }
            }
        },
